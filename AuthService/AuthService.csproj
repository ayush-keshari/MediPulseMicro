<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Entity Framework Core with SQL Server provider -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.4" />

    <!-- EF Core CLI tools for running migrations (dotnet ef migrations add ...) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.4" />

    <!-- BCrypt for secure password hashing (never store plain-text passwords) -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" -->

    <!-- Serilog for structured JSON logging -->
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Formatting.Json" Version="8.0.2" />

    <!-- JWT Bearer and Swashbuckle are now in Shared — pulled in transitively -->
  </ItemGroup>

  <ItemGroup>
    <!-- Reference our shared class library for Roles constants and UserRole enum -->
    <ProjectReference Include="..\Shared\Shared.csproj" />
  </ItemGroup>

</Project>