<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Entity Framework Core with SQL Server provider -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />

    <!-- EF Core CLI tools for running migrations (dotnet ef migrations add ...) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" />

    <!-- BCrypt for secure password hashing (never store plain-text passwords) -->
    <PackageReference Include="BCrypt.Net-Next" />

    <!-- Serilog for structured logging -->
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Serilog.Sinks.ApplicationInsights" />

    <!-- JWT Bearer and Swashbuckle are now in Shared - pulled in transitively -->
  </ItemGroup>

  <ItemGroup>
    <!-- Reference our shared class library for Roles constants and UserRole enum -->
    <ProjectReference Include="..\Shared\Shared.csproj" />
  </ItemGroup>

</Project>