<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <!-- Gives this class library access to ASP.NET Core types:
         IActionFilter, IExceptionFilter, IAuthorizationFilter, ILogger, HttpContext etc.
         Without this, a plain class library cannot reference those types. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- JWT Bearer — used by AddJwtAuthentication() extension method -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.4" />

    <!-- Swashbuckle — used by AddMediPulseSwagger() extension method -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.3.1" />

    <!-- EF Core Relational — provides the Migrate() extension method used by MigrateDatabase() -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.4" />
  </ItemGroup>

</Project>
