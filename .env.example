# Database Configuration
DB_SERVER=sqlserver
DB_NAME_MAIN=MedipulseMain
DB_NAME_AUDIT=MedipulseAudit
# WARNING: Do not use the default SA_PASSWORD in production. Set a strong password.
SA_PASSWORD=YOUR_STRONG_SA_PASSWORD_HERE

# JWT Configuration
# WARNING: JWT_KEY must be a strong, random string of at least 32 characters. Do not use the example value in production.
JWT_KEY=YOUR_STRONG_JWT_KEY_HERE_MIN_32_CHARS
JWT_ISSUER=MediPulseAuthService
JWT_AUDIENCE=MediPulseAPI
# Optional Sentry DSN for centralized exception tracking.
SENTRY_DSN=
